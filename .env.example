# MarketingOS — biến môi trường mẫu.
# Copy thành .env và điền giá trị. KHÔNG commit file .env thật.

# ── AI runtime (xem app/services/ai/providers/README.md) ─────────────────────
# fake   — chạy hoàn toàn offline, không gọi mạng. Mặc định an toàn.
# ollama — mô hình chạy TRÊN MÁY NÀY. Dữ liệu khách hàng không rời khỏi máy,
#          nên KHÔNG cần AI_EXTERNAL_ENABLED và không cần tick consent.
# anthropic / openai — provider NGOÀI, cần double-gate ở dưới.
AI_PROVIDER=fake

# Master-switch cho provider NGOÀI. Phải =true mới cho phép gửi dữ liệu ra ngoài,
# và mỗi lần gọi trong UI vẫn cần tick xác nhận riêng (double-gate).
# KHÔNG ảnh hưởng tới ollama — ollama chạy nội bộ.
AI_EXTERNAL_ENABLED=false

# API key chỉ cần khi bật provider ngoài. Không hard-code vào code.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Ollama (mô hình chạy trên máy) ──────────────────────────────────────────
# Bật bằng: AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Model dùng để sinh nội dung và dịch. qwen2.5:7b viết tiếng Việt tốt và bám
# JSON schema ổn định. Tải bằng: ollama pull qwen2.5:7b
# Model quá nhỏ (vd llama3.2:1b) KHÔNG trả nổi JSON hợp lệ — đừng dùng.
OLLAMA_MODEL=qwen2.5:7b

# ── Database (production-like dùng Postgres qua docker-compose) ──────────────
# DATABASE_URL=postgres://marketingos:marketingos@localhost:5432/marketingos

# ── Email giao dịch (chỉ mời/duyệt/nhắc hạn) ────────────────────────────────
# CHƯA khai SMTP_HOST → mail được soạn nhưng KHÔNG gửi đi đâu (adapter test).
# Cố ý như vậy: triển khai lần đầu không âm thầm gửi mail ra ngoài.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=no-reply@marketingos.local

# ── Rails ───────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=

# ── Chỉ dùng khi triển khai (xem docs/DEPLOY_VPS.md) ────────────────────────
# Tên miền hoặc IP của máy chủ. Khai giá trị này sẽ bật kiểm tra Host header
# (chống DNS rebinding) và dùng làm host trong link ở email.
APP_HOST=
# Tên miền phụ được phép (nếu có).
APP_HOST_EXTRA=
# Cổng và địa chỉ bind của container web.
# Mặc định 127.0.0.1 — an toàn khi VPS đã có reverse proxy giữ cổng 80/443.
# Không có proxy thì đặt APP_BIND=0.0.0.0 và APP_PORT=80.
APP_BIND=127.0.0.1
APP_PORT=3080
# Giới hạn RAM cho container Ollama. qwen2.5:7b cần ~6g.
OLLAMA_MEMORY=8g
