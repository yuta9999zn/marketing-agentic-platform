# Secrets — không bao giờ commit
.env
.env.*
!.env.example
config/master.key

/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-*
coverage/
tmp/cache
vendor/javascript
node_modules/

# Local agent flight logs
.kiai/
