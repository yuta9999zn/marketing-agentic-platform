<div class="auth-wrap">
  <div class="auth-card">
    <div class="brand"><span class="avatar avatar-lg avatar-navy" style="background:linear-gradient(135deg,#4F46E5,#0FAD9A);border-radius:10px">M</span> MarketingOS</div>
    <h1><%= t("marketingos.auth.signup_title") %></h1>
    <%= form_with url: signup_path, local: true do %>
      <div class="field">
        <label for="su-org"><%= t("marketingos.auth.org_name") %></label>
        <input type="text" id="su-org" name="organization_name" required>
      </div>
      <div class="field">
        <label for="su-name"><%= t("marketingos.auth.your_name") %></label>
        <input type="text" id="su-name" name="name" required>
      </div>
      <div class="field">
        <label for="su-email"><%= t("marketingos.auth.email") %></label>
        <input type="email" id="su-email" name="email" required>
      </div>
      <div class="field">
        <label for="su-password"><%= t("marketingos.auth.password_min") %></label>
        <input type="password" id="su-password" name="password" required minlength="8">
      </div>
      <button class="btn btn-primary"><%= t("marketingos.auth.create_workspace") %></button>
    <% end %>
  </div>
</div>
