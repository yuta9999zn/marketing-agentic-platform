<% content_for(:title) { "#{t('marketingos.facebook.posts.new')} · MarketingOS" } %>
<div class="page-head">
  <div>
    <h1><%= t("marketingos.facebook.posts.new") %></h1>
    <div class="sub"><%= icon("facebook", size: 14) %> <%= @connection.page_name %> · <%= t("marketingos.facebook.posts.new_sub") %></div>
  </div>
  <span class="spacer"></span>
  <%= ai_status_badge %>
</div>

<div class="ws-grid">
  <div class="ws-main">
    <div class="card copilot-card">
      <div class="card-head"><h2><%= icon("spark", size: 18) %> <%= t("marketingos.facebook.posts.ai_title") %></h2><span class="sub"><%= t("marketingos.facebook.posts.ai_sub") %></span></div>
      <div class="copilot-body">
        <%= form_with url: generate_facebook_posts_path, method: :post, class: "fb-ai-form" do |f| %>
          <div class="field">
            <%= f.label :brief, t("marketingos.facebook.posts.ai_brief"), style: "color:#fff" %>
            <%= f.text_area :brief, rows: 4, required: true, placeholder: t("marketingos.facebook.posts.ai_brief_placeholder") %>
          </div>
          <div class="form-grid-2">
            <div class="field">
              <%= f.label :goal, t("marketingos.facebook.posts.ai_goal"), style: "color:#fff" %>
              <%= f.text_field :goal, placeholder: t("marketingos.facebook.posts.ai_goal_placeholder") %>
            </div>
            <div class="field">
              <%= f.label :tone, t("marketingos.facebook.posts.ai_tone"), style: "color:#fff" %>
              <%= f.select :tone, [["Thân thiện", "thân thiện"], ["Chuyên nghiệp", "chuyên nghiệp"], ["Hài hước", "hài hước"], ["Khẩn trương / khuyến mãi", "khẩn trương"], ["Truyền cảm hứng", "truyền cảm hứng"]], include_blank: t("marketingos.common.none") %>
            </div>
          </div>
          <div class="form-grid-2">
            <div class="field">
              <%= f.label :campaign_id, t("marketingos.facebook.posts.form.campaign"), style: "color:#fff" %>
              <%= f.select :campaign_id, @campaigns.map { |c| [c.name, c.id] }, include_blank: t("marketingos.common.none") %>
            </div>
            <div class="field">
              <%= f.label :artifact_id, t("marketingos.facebook.posts.form.artifact"), style: "color:#fff" %>
              <%= f.select :artifact_id, @artifacts.map { |a| ["#{a.title} (#{a.campaign.name})", a.id] }, include_blank: t("marketingos.common.none") %>
            </div>
          </div>
          <%= f.button type: "submit", class: "btn btn-primary" do %><%= icon("spark", size: 16) %> <%= t("marketingos.facebook.posts.ai_generate") %><% end %>
          <div class="ai-note"><%= icon("alert", size: 14) %> <%= t("marketingos.facebook.posts.ai_note") %></div>
        <% end %>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2><%= t("marketingos.facebook.posts.manual_title") %></h2></div>
      <div class="card-body">
        <%= render "facebook/posts/form", post: @post, url: facebook_posts_path, method: :post,
              submit_label: t("marketingos.facebook.posts.create_draft"), timezones: @timezones,
              campaigns: @campaigns, artifacts: @artifacts %>
      </div>
    </div>
  </div>
  <div class="ws-right">
    <div class="card">
      <div class="card-head"><h2><%= t("marketingos.facebook.posts.flow_title") %></h2></div>
      <div class="card-body" style="font-size:13.5px;color:var(--muted)">
        <ol class="fb-steps" style="margin:0">
          <li><%= t("marketingos.facebook.posts.flow_1") %></li>
          <li><%= t("marketingos.facebook.posts.flow_2") %></li>
          <li><%= t("marketingos.facebook.posts.flow_3") %></li>
          <li><%= t("marketingos.facebook.posts.flow_4") %></li>
        </ol>
      </div>
    </div>
  </div>
</div>
