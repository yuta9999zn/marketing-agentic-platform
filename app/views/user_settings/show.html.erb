<div class="page-head">
  <div>
    <h1><%= t("marketingos.settings.title") %></h1>
    <div class="sub"><%= t("marketingos.settings.subtitle") %></div>
  </div>
</div>

<div class="card" style="max-width:560px">
  <div class="card-body" style="padding-top:16px">
    <%= form_with model: current_user, url: settings_path, method: :patch, local: true do |f| %>
      <% if current_user.errors.any? %>
        <div class="flash flash-alert" role="alert"><%= current_user.errors.full_messages.to_sentence %></div>
      <% end %>

      <div class="field">
        <%= f.label :locale, t("marketingos.settings.language") %>
        <%= f.select :locale,
              User::LOCALES.map { |l| [t("marketingos.settings.locales.#{l}"), l] },
              { selected: current_user.locale.presence || I18n.default_locale.to_s } %>
      </div>

      <div class="form-grid-2">
        <div class="field">
          <%= f.label :reminder_lead_minutes, t("marketingos.settings.reminder_lead") %>
          <%= f.select :reminder_lead_minutes,
                User::REMINDER_LEADS.map { |m| [t("marketingos.settings.leads.m#{m}"), m] },
                { selected: current_user.reminder_lead_minutes } %>
        </div>
        <div class="field">
          <%= f.label :reminder_channel, t("marketingos.settings.reminder_channel") %>
          <%= f.select :reminder_channel,
                User::REMINDER_CHANNELS.map { |c| [t("marketingos.settings.channels.#{c}"), c] },
                { selected: current_user.reminder_channel } %>
        </div>
      </div>
      <p class="task-sub" style="margin:4px 0 14px"><%= t("marketingos.settings.reminder_hint") %></p>

      <button class="btn btn-primary btn-sm"><%= t("marketingos.common.save") %></button>
    <% end %>
  </div>
</div>
